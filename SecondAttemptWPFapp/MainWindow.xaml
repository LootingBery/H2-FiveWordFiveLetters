<Window x:Class="SecondAttemptWPFapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SecondAttemptWPFapp"
        mc:Ignorable="d"
        Title="MainWindow" Height="401" Width="800">
    <Window.Resources>

    </Window.Resources>
    <Grid Background="#FFB9B9B9" Margin="0,0,0,-6">
        <Button IsEnabled="False" Name="Start" Content="Start" Click="FindSolutions_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Height="80" Width="150" Margin="250,15,0,0" RenderTransformOrigin="0.493,-0.4"/>
        <Button IsEnabled="True" Name="SelectFile" Content="Select File" HorizontalAlignment="Left" VerticalAlignment="Top" Height="80" Width="150" Margin="250,100,0,0" Click="SelectFile_Click"/>
        <Button IsEnabled="False" Name="DownloadResults" Content="Download results" HorizontalAlignment="Left" Margin="10,226,0,0" VerticalAlignment="Top" Width="127" Click="DownloadResults_Click"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="572,34,0,0" TextWrapping="Wrap" Text="{Binding WordsFound, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="120" TextAlignment="Center" />
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="447,77,0,0" TextWrapping="Wrap" Text="{Binding Stopwatch, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="245" TextAlignment="Center"/>
        <ListBox ItemsSource="{Binding Solutions, UpdateSourceTrigger=PropertyChanged}" Name="Results" Margin="10,10,555,170" Background="#FF5F5F5F" Foreground="White" />
        <TextBox HorizontalAlignment="Left" IsReadOnly="True" Margin="572,16,0,0" TextWrapping="Wrap" Text="Words found" VerticalAlignment="Top" Width="120"  Background="{x:Null}" FontWeight="Bold" TextAlignment="Center"/>
        <TextBox HorizontalAlignment="Left" IsReadOnly="True" Margin="447,59,0,0" TextWrapping="Wrap" Text="Time Elapsed" VerticalAlignment="Top" Width="245"  Background="{x:Null}" FontWeight="Bold" TextAlignment="Center"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="447,34,0,0" TextWrapping="Wrap" Text="{Binding SolutionsFound, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="120" TextAlignment="Center" />
        <TextBox HorizontalAlignment="Left" IsReadOnly="True" Margin="447,16,0,0" TextWrapping="Wrap" Text="Solutions found" VerticalAlignment="Top" Width="120"  Background="{x:Null}" FontWeight="Bold" TextAlignment="Center"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="250,185,0,0" TextWrapping="Wrap" Name="FileTextBox" VerticalAlignment="Top" Width="540"/>

    </Grid>
</Window>
