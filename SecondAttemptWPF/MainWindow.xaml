<Window x:Class="SecondAttemptWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SecondAttemptWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FFB9B9B9">
        <Button Content="Start" HorizontalAlignment="Left" VerticalAlignment="Top" Height="80" Width="150" Margin="345,10,0,0" RenderTransformOrigin="0.493,-0.4"/>
        <Button Content="Select File" HorizontalAlignment="Left" VerticalAlignment="Top" Height="80" Width="150" Margin="640,10,0,0"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="10,223,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="220,223,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,10,460,216" Background="#FF5F5F5F" Foreground="White"/>

    </Grid>
</Window>
